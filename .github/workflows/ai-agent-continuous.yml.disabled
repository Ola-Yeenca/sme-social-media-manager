name: 🤖 Simple AI Mention Checker (RESPONDS TO @MENTIONS)

# Prevent multiple AI agent instances from running simultaneously
concurrency:
  group: ai-agent-monitoring
  cancel-in-progress: true

on:
  schedule:
    # Run Simple AI Mention Checker every hour
    - cron: '0 * * * *'
  workflow_dispatch:
    inputs:
      duration:
        description: 'Monitoring Duration (minutes)'
        required: true
        default: '60'
        type: choice
        options:
          - '30'
          - '60'
          - '120'
          - '300'

jobs:
  simple-ai-agent:
    runs-on: ubuntu-latest
    timeout-minutes: 10  # 10 minutes max (simple single check)
    
    steps:
    - name: 🚀 Checkout Repository
      uses: actions/checkout@v4
      
    - name: 🐍 Setup Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'
        
    - name: 📦 Install Dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt
        
    - name: 🤖 Run Simple AI Mention Checker
      env:
        # Twitter/X API Credentials
        TWITTER_API_KEY: ${{ secrets.TWITTER_API_KEY }}
        TWITTER_API_SECRET: ${{ secrets.TWITTER_API_SECRET }}
        TWITTER_ACCESS_TOKEN: ${{ secrets.TWITTER_ACCESS_TOKEN }}
        TWITTER_ACCESS_TOKEN_SECRET: ${{ secrets.TWITTER_ACCESS_TOKEN_SECRET }}
        TWITTER_BEARER_TOKEN: ${{ secrets.TWITTER_BEARER_TOKEN }}
        
        # Notion Configuration (optional)
        NOTION_API_KEY: ${{ secrets.NOTION_API_KEY }}
        SOCIAL_MEDIA_DB_ID: ${{ secrets.SOCIAL_MEDIA_DB_ID }}
        
        LOG_LEVEL: "INFO"
        
      run: |
        echo "🤖 Starting Simple AI Mention Checker..."
        echo "🎯 Will check @smeanalytica mentions once and respond"
        
        # Create logs directory
        mkdir -p logs
        mkdir -p automation_logs
        
        # Run Simple AI Mention Checker (single check, no complex monitoring)
        echo "🔄 Running simple mention check (should complete in under 2 minutes)"
        python main.py --mode=ai_agent_simple 2>&1 | tee agent_output.log
        
        echo "✅ Simple AI Mention Checker completed"
        
    - name: 📊 Upload Check Logs
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: simple-ai-agent-${{ github.run_number }}
        path: |
          logs/
          automation_logs/
        retention-days: 3
        
    - name: 📈 Report Check Status
      if: always()
      run: |
        echo "🎉 Simple AI Mention Checker completed!"
        echo "📊 Check artifacts for detailed logs"
        
        # Show recent log entries if available
        if [ -f "logs/social_manager.log" ]; then
          echo "📝 Recent activity:"
          tail -10 logs/social_manager.log || echo "No recent logs found"
        fi
        
        echo ""
        echo "🤖 Simple AI Status:"
        echo "✅ Checked @smeanalytica mentions"
        echo "✅ Responded to new mentions"
        echo "✅ Next check runs automatically in 1 hour"
        echo ""
        echo "💡 Test it: Tweet @smeanalytica and get an AI response!"
